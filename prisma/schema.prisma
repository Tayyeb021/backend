generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String    @db.VarChar
  tradeLicenseNumber  String?   @unique @db.VarChar
  registrationNumber  String?   @unique @db.VarChar
  vatTrn              String?   @unique @db.VarChar
  corporateTaxTrn     String?   @unique @db.VarChar
  freeZoneName        String?   @db.VarChar
  licenseType         String?   @db.VarChar
  licenseExpiryDate   DateTime? @db.Timestamp(6)
  industry            String?   @db.VarChar
  companySize         String?   @db.VarChar
  website             String?   @db.VarChar
  email               String    @db.VarChar
  phone               String?   @db.VarChar
  address             String?
  poBox               String?   @db.VarChar
  city                String?   @db.VarChar
  emirate             String?   @db.VarChar
  country             String?   @default("UAE") @db.VarChar
  postalCode          String?   @db.VarChar
  logoUrl             String?
  description         String?
  authorizedSignatory Json?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now()) @db.Timestamp(6)
  updatedAt           DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  users               User[]

  @@map("companies")
}

model User {
  id         String      @id(map: "PK_a3ffb1c0c8416b9fc6f907b7433") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String      @unique(map: "IDX_USERS_EMAIL") @db.VarChar
  password   String      @db.VarChar
  firstName  String      @db.VarChar
  lastName   String      @db.VarChar
  phone      String?     @db.VarChar
  role       UserRole    @default(client)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now()) @db.Timestamp(6)
  updatedAt  DateTime    @default(now()) @updatedAt @db.Timestamp(6)
  companyId  String?     @db.Uuid
  clients            Client[]            @relation("ClientCreatedBy")
  interviews         Interview[]         @relation("InterviewClient")
  jobs               Job[]               @relation("JobClient")
  company            Company?            @relation(fields: [companyId], references: [id])
  interviewTemplates InterviewTemplate[] @relation("TemplateClient")

  @@map("users")
}

model Job {
  id          String @id(map: "PK_cf0a6c42b72fcc7f7c237def345") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String @db.VarChar(255)
  description String

  // Skills & experience
  requiredSkills  String[]
  experienceLevel ExperienceLevel
  seniorityLevel  SeniorityLevel

  // Job type & engagement
  jobType          JobType
  engagementLength EngagementType
  workMode         WorkMode

  // Location
  country  String? @db.VarChar(100)
  timezone String? @db.VarChar(50)

  // Compensation
  minSalary   Int?
  maxSalary   Int?
  currency    String?      @db.VarChar(10)
  billingType BillingType?

  // Hiring info
  openings       Int         @default(1)
  hiringDeadline DateTime?
  priority       JobPriority @default(normal)

  // Status & lifecycle
  status      JobStatus @default(draft)
  publishedAt DateTime?
  expiresAt   DateTime?

  // Ownership
  clientId String @db.Uuid
  client   User   @relation("JobClient", fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Relations
  candidates Candidate[]
  interviews Interview[]

  // Metadata
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@index([clientId], map: "IDX_JOBS_CLIENT_ID")
  @@index([status], map: "IDX_JOBS_STATUS")
  @@index([jobType, workMode])
  @@map("jobs")
}

model Candidate {
  id              String          @id(map: "PK_140681296bf033ab1eb95288abb") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName       String          @db.VarChar
  lastName        String          @db.VarChar
  email           String          @unique(map: "IDX_CANDIDATES_EMAIL") @db.VarChar
  phone           String?         @db.VarChar
  resumeUrl       String?
  profileData     Json?
  skills          String[]
  experienceYears Int?
  location        String?         @db.VarChar
  sourcePlatform  String?         @db.VarChar
  status          CandidateStatus @default(sourced)
  jobId           String          @db.Uuid
  createdAt       DateTime        @default(now()) @db.Timestamp(6)
  updatedAt       DateTime        @default(now()) @updatedAt @db.Timestamp(6)
  job             Job             @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_426d378178da5713f1ab30daabc")
  interviews      Interview[]

  @@index([jobId], map: "IDX_CANDIDATES_JOB_ID")
  @@index([status], map: "IDX_CANDIDATES_STATUS")
  @@map("candidates")
}

model Interview {
  id                       String            @id(map: "PK_fd41af1f96d698fa33c2f070f47") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId              String            @db.Uuid
  jobId                    String            @db.Uuid
  clientId                 String            @db.Uuid
  status                   InterviewStatus   @default(scheduled)
  type                     InterviewType     @default(live)
  language                 InterviewLanguage @default(en)
  scheduledAt              DateTime?         @db.Timestamp(6)
  startedAt                DateTime?         @db.Timestamp(6)
  completedAt              DateTime?         @db.Timestamp(6)
  dailyRoomId              String?           @db.VarChar
  videoUrl                 String?           @db.VarChar
  transcript               String?
  transcriptWithTimestamps Json?
  scores                   Json?
  aiSummary                String?
  templateId               String?           @db.Uuid
  allowSelfScheduling      Boolean          @default(false)
  deadline                 DateTime?         @db.Timestamp(6)
  invitationSentAt         DateTime?         @db.Timestamp(6)
  candidateStartedAt        DateTime?         @db.Timestamp(6)
  dateOptions              Json?            // Array of 3 date options: [{ date: string, selected: boolean }]
  roundNumber              Int?             @default(1) // Interview round number (1, 2, 3, etc.)
  externalMeetingUrl       String?          @db.VarChar // External meeting URL (Zoom, Teams, etc.)
  createdAt                DateTime          @default(now()) @db.Timestamp(6)
  updatedAt                DateTime          @default(now()) @updatedAt @db.Timestamp(6)
  job                      Job               @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_86c6a5b65c91b118189dc011aaa")
  candidate                Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_9b47fb5a4e06ccb14d20d2f06fd")
  client                   User              @relation("InterviewClient", fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  template                 InterviewTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([candidateId], map: "IDX_INTERVIEWS_CANDIDATE_ID")
  @@index([clientId], map: "IDX_INTERVIEWS_CLIENT_ID")
  @@index([jobId], map: "IDX_INTERVIEWS_JOB_ID")
  @@index([status], map: "IDX_INTERVIEWS_STATUS")
  @@index([type], map: "IDX_INTERVIEWS_TYPE")
  @@map("interviews")
}

model InterviewTemplate {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String            @db.VarChar(255)
  description String?
  clientId    String            @db.Uuid
  isDefault   Boolean           @default(false)
  isPublic    Boolean           @default(false)
  createdAt   DateTime          @default(now()) @db.Timestamp(6)
  updatedAt   DateTime          @default(now()) @updatedAt @db.Timestamp(6)
  client      User              @relation("TemplateClient", fields: [clientId], references: [id], onDelete: Cascade)
  questions   InterviewQuestion[]
  interviews Interview[]

  @@index([clientId], map: "IDX_TEMPLATES_CLIENT_ID")
  @@map("interview_templates")
}

model InterviewQuestion {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId  String            @db.Uuid
  question    String
  type        QuestionType      @default(behavioral)
  order       Int               @default(0)
  timeLimit   Int?              // Time limit in seconds
  createdAt   DateTime          @default(now()) @db.Timestamp(6)
  updatedAt   DateTime          @default(now()) @updatedAt @db.Timestamp(6)
  template    InterviewTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId], map: "IDX_QUESTIONS_TEMPLATE_ID")
  @@map("interview_questions")
}

enum QuestionType {
  behavioral
  technical
  situational
  cultural_fit
  coding
  system_design
}

model Client {
  id                        String       @id(map: "PK_f1ab7cf3a5714dbc6bb4e1c28a4") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                      ClientType
  email                     String       @unique(map: "IDX_CLIENTS_EMAIL") @db.VarChar
  phone                     String?      @db.VarChar
  address                   String?
  city                      String?      @db.VarChar
  state                     String?      @db.VarChar
  country                   String?      @db.VarChar
  postalCode                String?      @db.VarChar
  status                    ClientStatus @default(active)
  notes                     String?
  companyName               String?      @db.VarChar
  companyRegistrationNumber String?      @db.VarChar
  taxId                     String?      @db.VarChar
  vatNumber                 String?      @db.VarChar
  industry                  String?      @db.VarChar
  companySize               String?      @db.VarChar
  website                   String?      @db.VarChar
  contactPersonFirstName    String?      @db.VarChar
  contactPersonLastName     String?      @db.VarChar
  contactPersonEmail        String?      @db.VarChar
  contactPersonPhone        String?      @db.VarChar
  contactPersonTitle        String?      @db.VarChar
  firstName                 String?      @db.VarChar
  lastName                  String?      @db.VarChar
  dateOfBirth               DateTime?    @db.Timestamp(6)
  nationalId                String?      @db.VarChar
  passportNumber            String?      @db.VarChar
  createdById               String?      @db.Uuid
  createdAt                 DateTime     @default(now()) @db.Timestamp(6)
  updatedAt                 DateTime     @default(now()) @updatedAt @db.Timestamp(6)
  createdBy                 User?        @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_d9da07105d53c46866e802f2590")

  @@index([createdById], map: "IDX_CLIENTS_CREATED_BY")
  @@index([status], map: "IDX_CLIENTS_STATUS")
  @@index([type], map: "IDX_CLIENTS_TYPE")
  @@map("clients")
}

model migrations {
  id        Int    @id(map: "PK_8c82d7f526340ab734260ea46be") @default(autoincrement())
  timestamp BigInt
  name      String @db.VarChar
}

enum CandidateStatus {
  sourced
  contacted
  interviewed
  advanced
  rejected
}

enum ClientStatus {
  active
  inactive
  pending
}

enum ClientType {
  company
  individual
}

enum InterviewLanguage {
  en
  ar
  hi
  ur
  bn
}

enum InterviewStatus {
  scheduled
  in_progress
  completed
  cancelled
  missed
  pending_candidate_response
  awaiting_review
}

enum InterviewType {
  live
  on_demand
}

enum JobStatus {
  draft
  published
  paused
  closed
}

enum JobType {
  full_time
  part_time
  contract
  freelance
}

enum WorkMode {
  remote
  hybrid
  onsite
}

enum EngagementType {
  short_term
  long_term
}

enum BillingType {
  hourly
  monthly
  fixed
}

enum SeniorityLevel {
  junior
  mid
  senior
  expert
}

enum ExperienceLevel {
  one_to_three
  three_to_five
  five_plus
}

enum JobPriority {
  low
  normal
  high
}

enum UserRole {
  admin
  recruiter
  client
  interviewee
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?  @db.Uuid
  userEmail   String?  @db.VarChar
  action      String   @db.VarChar(100)
  resource    String   @db.VarChar(100)
  resourceId  String?  @db.Uuid
  changes     Json?
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?
  metadata    Json?
  organizationId String? @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamp(6)

  @@index([userId], map: "IDX_AUDIT_USER_ID")
  @@index([resource, resourceId], map: "IDX_AUDIT_RESOURCE")
  @@index([action], map: "IDX_AUDIT_ACTION")
  @@index([createdAt], map: "IDX_AUDIT_CREATED_AT")
  @@index([organizationId], map: "IDX_AUDIT_ORG_ID")
  @@map("audit_logs")
}

model Permission {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String   @unique @db.VarChar(100)
  resource      String   @db.VarChar(100)
  action        String   @db.VarChar(50)
  description   String?  @db.VarChar(255)
  conditions    Json?
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamp(6)

  roles         RolePermission[]

  @@index([resource, action], map: "IDX_PERM_RESOURCE_ACTION")
  @@map("permissions")
}

model Role {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String   @db.VarChar(100)
  description   String?  @db.VarChar(255)
  organizationId String? @db.Uuid
  isSystem      Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamp(6)

  permissions   RolePermission[]
  userRoleAssignments UserRoleAssignment[]

  @@unique([name, organizationId], map: "UQ_ROLE_NAME_ORG")
  @@index([organizationId], map: "IDX_ROLE_ORG_ID")
  @@map("roles")
}

model RolePermission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamp(6)

  role         Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], map: "UQ_ROLE_PERM")
  @@map("role_permissions")
}

model UserRoleAssignment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid
  roleId       String   @db.Uuid
  organizationId String? @db.Uuid
  assignedAt   DateTime @default(now()) @db.Timestamp(6)
  assignedBy   String?  @db.Uuid

  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, organizationId], map: "UQ_USER_ROLE")
  @@index([userId], map: "IDX_USER_ROLE_USER")
  @@index([organizationId], map: "IDX_USER_ROLE_ORG")
  @@map("user_roles")
}

model Webhook {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String? @db.Uuid
  url           String   @db.VarChar(500)
  events        String[] // Array of event types
  secret        String   @db.VarChar(255)
  isActive      Boolean  @default(true)
  headers       Json?
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamp(6)

  deliveries    WebhookDelivery[]

  @@index([organizationId], map: "IDX_WEBHOOK_ORG")
  @@map("webhooks")
}

model WebhookDelivery {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  webhookId   String   @db.Uuid
  event       String   @db.VarChar(100)
  payload     Json
  status      String   @db.VarChar(50) // pending, success, failed
  statusCode  Int?
  response    String?
  attempts    Int      @default(0)
  deliveredAt DateTime? @db.Timestamp(6)
  createdAt   DateTime @default(now()) @db.Timestamp(6)

  webhook     Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId], map: "IDX_WEBHOOK_DELIVERY_WEBHOOK")
  @@index([status], map: "IDX_WEBHOOK_DELIVERY_STATUS")
  @@map("webhook_deliveries")
}